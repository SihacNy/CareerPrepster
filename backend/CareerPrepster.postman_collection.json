            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Full Stack Developer CV\",\n  \"templateId\": \"classic-ats\",\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"+1 (555) 234-5678\",\n  \"location\": \"San Francisco, CA\",\n  \"linkedinUrl\": \"https://linkedin.com/in/janedoe\",\n  \"githubUrl\": \"https://github.com/janedoe\",\n  \"websiteUrl\": \"https://janedoe.dev\",\n  \"summary\": \"High-impact Software Engineer with expertise in TypeScript, React, and Node.js.\",\n  \"sections\": [\n    {\n      \"sectionType\": \"EXPERIENCE\",\n      \"orderIndex\": 0,\n      \"isVisible\": true,\n      \"items\": [\n        {\n          \"title\": \"Software Engineer\",\n          \"subtitle\": \"Tech Innovations Inc.\",\n          \"location\": \"San Francisco, CA\",\n          \"startDate\": \"2023-01\",\n          \"endDate\": \"Present\",\n          \"isCurrent\": true,\n          \"orderIndex\": 0,\n          \"bulletPoints\": [\n            {\n              \"text\": \"Architected microservices that reduced API latency by 35% across 200k daily users.\",\n              \"actionVerb\": \"Architected\",\n              \"framework\": \"XYZ\",\n              \"hasMetric\": true,\n              \"orderIndex\": 0\n            },\n            {\n              \"text\": \"Spearheaded test coverage initiative, improving unit test coverage from 45% to 88% using Jest.\",\n              \"actionVerb\": \"Spearheaded\",\n              \"framework\": \"STAR\",\n              \"hasMetric\": true,\n              \"orderIndex\": 1\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"sectionType\": \"EDUCATION\",\n      \"orderIndex\": 1,\n      \"isVisible\": true,\n      \"items\": [\n        {\n          \"title\": \"B.S. in Computer Science\",\n          \"subtitle\": \"University of California, Berkeley\",\n          \"location\": \"Berkeley, CA\",\n          \"startDate\": \"2019-09\",\n          \"endDate\": \"2023-05\",\n          \"isCurrent\": false,\n          \"orderIndex\": 0,\n          \"bulletPoints\": [\n            {\n              \"text\": \"Graduated Magna Cum Laude with a 3.85 GPA.\",\n              \"actionVerb\": \"Graduated\",\n              \"framework\": \"STANDARD\",\n              \"hasMetric\": true,\n              \"orderIndex\": 0\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"skillGroups\": [\n    {\n      \"categoryName\": \"Languages\",\n      \"skills\": [\"TypeScript\", \"JavaScript\", \"Python\", \"SQL\"],\n      \"orderIndex\": 0\n    },\n    {\n      \"categoryName\": \"Frameworks & Tools\",\n      \"skills\": [\"React\", \"Next.js\", \"Node.js\", \"Express\", \"Prisma\", \"Docker\"],\n      \"orderIndex\": 1\n    }\n  ]\n}"
            },
            "url": {
