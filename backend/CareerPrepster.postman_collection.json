    {
      "name": "4. Job Role Catalog",
      "item": [
        {
          "name": "List Job Roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.length > 0) {",
                  "        pm.collectionVariables.set('roleId', json.data[0].id);",
                  "        console.log('Saved first roleId:', json.data[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/job-roles?search=engineer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-roles"],
              "query": [
                {
                  "key": "search",
                  "value": "engineer"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Starter Bullets for Role",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/job-roles/{{roleId}}/bullets?framework=XYZ",
              "host": ["{{baseUrl}}"],
              "path": ["api", "job-roles", "{{roleId}}", "bullets"],
              "query": [
                {
                  "key": "framework",
                  "value": "XYZ"
                }
              ]
            }
          },
          "response": []
        }
      ]
