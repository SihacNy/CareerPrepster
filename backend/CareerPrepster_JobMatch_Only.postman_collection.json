{
  "info": {
    "_postman_id": "c71a3994-1a3b-4892-91d8-8f81e3a968bb",
    "name": "CareerPrepster - Job Match (Latest Update Only)",
    "description": "Dedicated Postman collection to test only the latest Personalized Job Match feature endpoints: Dev Login, LinkedIn/Seed Discovery, Explainable Recommendations, Filtering, Status Tracking (Save/Dismiss/Apply), Preferences, and Refresh Cooldown.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "recommendationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Quick Authentication (Run This First)",
      "item": [
        {
          "name": "Dev Sign-In (Sets Cookie & {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('token', json.data.token);",
                  "        console.log('Token saved to {{token}} variable!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guest_1789555828066@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/dev-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "dev-login"]
            },
            "description": "Signs in as the test candidate, sets the HttpOnly cookie, and automatically populates the {{token}} collection variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Job Discovery & Ingestion",
      "item": [
        {
          "name": "Trigger Discovery (LinkedIn & Seed Catalog)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keywords\": \"Frontend Developer\",\n  \"location\": \"Remote\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/admin/discover",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "admin", "discover"]
            },
            "description": "Triggers multi-provider scraping and deduplication across LinkedIn and the curated tech seed catalog. Updates existing jobs by dedupHash without creating duplicates."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Candidate Recommendations",
      "item": [
        {
          "name": "List Recommendations (Active)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.items && json.data.items.length > 0) {",
                  "        pm.collectionVariables.set('recommendationId', json.data.items[0].id);",
                  "        console.log('Saved recommendationId:', json.data.items[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/recommendations?status=ACTIVE&sortBy=matchScore&sortOrder=desc&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "recommendations"],
              "query": [
                { "key": "status", "value": "ACTIVE" },
                { "key": "sortBy", "value": "matchScore" },
                { "key": "sortOrder", "value": "desc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Fetches candidate recommendations with explainable scores, matched skills, missing skills, and employer logo. If user has no matches yet, evaluates matches automatically."
          },
          "response": []
        },
        {
          "name": "Filter Recommendations (Remote + Min Score 70%)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/recommendations?minScore=70&arrangement=REMOTE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "recommendations"],
              "query": [
                { "key": "minScore", "value": "70" },
                { "key": "arrangement", "value": "REMOTE" }
              ]
            },
            "description": "Multi-facet filtering: filters recommendations by minimum match score threshold and work arrangement."
          },
          "response": []
        },
        {
          "name": "Get Recommendation Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/recommendations/{{recommendationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "recommendations", "{{recommendationId}}"]
            },
            "description": "Returns full job specifications and multi-pillar score breakdown (skills, role, experience, preferences) with evidence reasons and skill gap advice."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Opportunity Pipeline & Status Actions",
      "item": [
        {
          "name": "Save / Bookmark Job",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SAVED\",\n  \"userNotes\": \"Reviewed LinkedIn posting. Tailoring CV bullet points to match React and TypeScript requirements.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/recommendations/{{recommendationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "recommendations", "{{recommendationId}}", "status"]
            },
            "description": "Bookmarks the opportunity and stores candidate personal notes."
          },
          "response": []
        },
        {
          "name": "List Saved Jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/recommendations?status=SAVED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "recommendations"],
              "query": [
                { "key": "status", "value": "SAVED" }
              ]
            },
            "description": "Retrieves only bookmarked opportunities for the candidate."
          },
          "response": []
        },
        {
          "name": "Mark Job as Applied",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPLIED\",\n  \"userNotes\": \"Submitted application through verified LinkedIn posting link.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/recommendations/{{recommendationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "recommendations", "{{recommendationId}}", "status"]
            },
            "description": "Updates the candidate's tracking state to APPLIED."
          },
          "response": []
        },
        {
          "name": "Dismiss Job",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DISMISSED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/recommendations/{{recommendationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "recommendations", "{{recommendationId}}", "status"]
            },
            "description": "Dismisses an irrelevant job, suppressing it from active recommendation feeds."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Candidate Search Preferences",
      "item": [
        {
          "name": "Get Search Preferences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "preferences"]
            },
            "description": "Retrieves candidate target roles, preferred locations, and work arrangement preferences."
          },
          "response": []
        },
        {
          "name": "Update Search Preferences",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"desiredRoles\": [\n    \"Frontend Developer\",\n    \"Junior Full Stack Engineer\"\n  ],\n  \"preferredLocations\": [\n    \"Phnom Penh\",\n    \"Remote\"\n  ],\n  \"preferredArrangement\": \"REMOTE\",\n  \"preferredEmploymentType\": \"FULL_TIME\",\n  \"minSalary\": 600,\n  \"notifyDaily\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "preferences"]
            },
            "description": "Updates search criteria and triggers asynchronous recommendation recalculation."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Refresh & Cooldown Status",
      "item": [
        {
          "name": "Trigger Match Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "refresh"]
            },
            "description": "Triggers asynchronous recalculation of recommendations. Returns 202 Accepted, or 429 Too Many Requests if the 15-minute cooldown is active."
          },
          "response": []
        },
        {
          "name": "Get Refresh Status & Cooldown",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/refresh/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs", "refresh", "status"]
            },
            "description": "Polls the status of the background recalculation and returns remaining cooldown seconds."
          },
          "response": []
        }
      ]
    }
  ]
}
